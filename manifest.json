{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "AI Leak Guard",
  "description": "__MSG_extDesc__",
  "version": "0.3.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://www.meta.ai/*"
      ],
      "js": [
        "src/detectors.js",
        "src/i18n.js",
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}